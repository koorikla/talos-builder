diff --git c/kernel/build/patches/9001-wifi-brcmfmac-report-carrier-through-ethtool-get_link.patch i/kernel/build/patches/9001-wifi-brcmfmac-report-carrier-through-ethtool-get_link.patch
new file mode 100644
index 0000000..6bd628d
--- /dev/null
+++ i/kernel/build/patches/9001-wifi-brcmfmac-report-carrier-through-ethtool-get_link.patch
@@ -0,0 +1,18 @@
+From: koorikla
+Subject: [PATCH] wifi: brcmfmac: report carrier through ethtool get_link
+
+brcmfmac only implements .get_drvinfo, so ETHTOOL_MSG_LINKSTATE_GET omits
+the link attribute and userspace that relies on it (Talos LinkStatus)
+treats an associated interface as having no carrier. Use the generic
+helper, which reports netif_carrier_ok().
+
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c
+@@ -585,6 +585,7 @@
+ 
+ static const struct ethtool_ops brcmf_ethtool_ops = {
+ 	.get_drvinfo = brcmf_ethtool_get_drvinfo,
++	.get_link = ethtool_op_get_link,
+ };
+ 
+ static int brcmf_netdev_stop(struct net_device *ndev)
